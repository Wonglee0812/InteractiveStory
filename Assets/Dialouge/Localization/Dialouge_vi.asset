--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialouge_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 3f107cef2cb2f3643a370e954cd4564d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 509934394802245
    m_Localized: "Zenith General: Haizzz th\u1EADt s\u1EF1 c\xF3 th\u1EC3 h\u1ECFi
      nh\u1EEFng th\u1EE9 ng\u1EDB ng\u1EA9n nh\u01B0 v\u1EADy sao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802235
    m_Localized: "Zenith General: Ng\u01B0\u01A1i bi\u1EBFt \u0111\xF3 l\xE0 g\xEC
      ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802259
    m_Localized: "Zenith General: \u0111\u01B0\u1EE3c th\xF4i, nh\u01B0ng hi\u1EC7n
      t\u1EA1i ng\u01B0\u01A1i v\u1EABn \u0111ang b\u1ECB theo d\xF5i kh\xE1 s\xE1t
      sao"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802329
    m_Localized: "Zenith General: \u0110\u01B0\u1EE3c r\u1ED3i, quy\u1EBFt \u0111\u1ECBnh
      \u0111i,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802191
    m_Localized: "Player: D\xF9ng b\u1ED9 n\xE3o \u0111\u1EC3 \u0111\u1EC3,...\u0111i\u1EC1u
      khi\u1EC3n nh\u1EEFng c\u1ED5 m\xE1y n\xE0y sao"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802340
    m_Localized: "Zenith General: V\u1EADy th\xEC c\u1EE9 ch\u1EBFt cho nh\u1EEFng
      k\u1EBB ch\u1EE7 nh\xE2n th\u1EADm ch\xED c\xF2n ch\u1EA3 th\xE8m nh\u1EDB
      t\xEAn ng\u01B0\u01A1i \u0111i!"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802342
    m_Localized: "Zenith General: Mau l\xEAn, mau b\u1EAFn h\u1EA1 chi\u1EBFc m\xE1y
      bay \u0111\xF3 \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802217
    m_Localized: "Zenith General: kh\xF4ng d\u01B0\u1EDBi tay ta,... th\xEC c\u0169ng
      l\xE0 d\u01B0\u1EDBi tay Apex.."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802286
    m_Localized: "Zenith General: Ta kh\xF4ng bi\u1EBFt n\xEAn g\u1ECDi ng\u01B0\u01A1i
      l\xE0 con ch\xF3 trung th\xE0nh.."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802275
    m_Localized: "Zenith General: Ta ch\u1EC9 l\xE0 \u0111ang \u0111\u1EC1 ngh\u1ECB
      th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802290
    m_Localized: "Zenith General: Ch\u01B0a k\u1EC3 d\xF9 ng\u01B0\u01A1i c\xF3 ho\xE0n
      th\xE0nh nhi\u1EC7m v\u1EE5 \u0111i n\u1EEFa th\xEC ng\u01B0\u01A1i c\u0169ng
      th\u1EA5y r\u1ED3i \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802278
    m_Localized: "Zenith General: N\xEAn suy ngh\u0129 cho th\u1EADt k\u1EF9 \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802214
    m_Localized: "Zenith General: Ngu ng\u1ED1c hay kh\xF4ng l\xE0 vi\u1EC7c c\u1EE7a
      ng\u01B0\u01A1i,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802226
    m_Localized: "Zenith General: Ng\u01B0\u01A1i ngh\u0129 xem, \u0111i l\xE0m nhi\u1EC7m
      v\u1EE5,...."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802296
    m_Localized: "Player: Nhanh ch\xF3ng \u0111i, n\u1EBFu bi\u1EBFt th\xEC ta c\xF2n
      h\u1ECFi ng\u01B0\u01A1i l\xE0m g\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802190
    m_Localized: "Player: ch\xFAng ch\xFAng..."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802283
    m_Localized: "Zenith General: Apex li\xEAn quan g\xEC \u1EDF \u0111\xE2y sao....\u0111\u1EC3
      xem"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802319
    m_Localized: "Zenith General: Th\xEC c\u1EE9 \u0111\u01A1n gi\u1EA3n xem nh\u01B0
      b\u1ECDn ta ti\u1EBFc m\u1ED9t nh\xE2n t\xE0i nh\u01B0 ng\u01B0\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802184
    m_Localized: "Player: B\u1ECDn ch\xFAng \u0111\xE3 l\xE0m g\xEC v\u1EDBi nh\u1EEFng
      c\u1ED5 m\xE1y n\xE0y \u0110\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802300
    m_Localized: "Zenith General: nh\u01B0ng trong qu\xE1 kh\u1EE9 do c\xF4ng ngh\u1EC7
      qu\xE1 kh\xF3 \u0111\u1EC3 ki\u1EC3m so\xE1t,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802332
    m_Localized: "Zenith General: M\u1ED9t quy\u1EBFt \u0111\u1ECBnh th\xF4ng minh."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802261
    m_Localized: "Zenith General: N\xE3y gi\u1EDD n\xF3 ho\xE0n to\xE0n im l\u1EB7ng
      l\xE0 v\xEC \u1EDF trong \u0111\xE2y s\xF3ng v\xF4 tuy\u1EBFn \u0111\xE3 b\u1ECB
      v\xF4 hi\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802186
    m_Localized: "Player: Nh\u01B0ng t\u1EA1i sao l\u1EA1i c\xF3 c\u1EA3nh b\xE1o
      v\u1EADy ch\u1EE9,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802216
    m_Localized: "Zenith General: \u0110\u1EB1ng n\xE0o ng\u01B0\u01A1i c\u0169ng
      s\u1EBD ph\u1EA3i ch\u1EBFt,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802305
    m_Localized: "Zenith General: Kh\xF4ng ch\u1EC9 v\u1EADy khu v\u1EF1c n\u1ED5
      g\u1EA7n nh\u01B0 s\u1EBD tr\u1EDF th\xE0nh v\xF9ng \u0111\u1EA5t ch\u1EBFt
      r\u1EA5t l\xE2u v\u1EC1 s\xE2u"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802339
    m_Localized: "Zenith General: Th\u1EADt \u0111\xE1ng th\u1EA5t v\u1ECDng v\xE0
      ti\u1EBFc nu\u1ED1i cho m\u1ED9t nh\xE2n t\xE0i nh\u01B0 ng\u01B0\u01A1i ph\u1EA3i
      b\u1ECF m\u1EA1ng \u1EDF \u0111\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802222
    m_Localized: "\u0110\u1EE7 r\u1ED3i. Tao \u0111\xE3 c\xF3 s\u1EF1 l\u1EF1a ch\u1ECDn
      c\u1EE7a m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802221
    m_Localized: "Sao ng\u01B0\u01A1i bi\u1EBFt ta \u1EDF \u0111\xE2y, ta nh\u1EDB
      r\xF5 m\xECnh \u0111\xE2u l\xE0m g\xEC l\u1ED9 li\u1EC5u."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802314
    m_Localized: "Player: m\xE0 l\u1EA1i c\u1EA5t c\xF4ng \u0111\u1EBFn \u0111\xE2y
      m\u1EDDi m\u1ED9c."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802303
    m_Localized: "Zenith General: khi k\xEDch ho\u1EA1t n\xF3 s\u1EBD t\u1EA1o ra
      m\u1ED9t v\u1EE5 n\u1ED5 v\u1EDBi xung l\u1EF1c c\u1EF1c l\u1EDBn,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802326
    m_Localized: "Zenith General: N\xEAn cu\u1ED9c tr\xF2 chuy\u1EC7n \u1EDF \u0111\xE2y,
      kh\xF4ng ai bi\u1EBFt ngo\xE0i ta v\xE0 ng\u01B0\u01A1i \u0111\xE2u,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802304
    m_Localized: "Zenith General: c\xF3 kh\u1EA3 n\u0103ng th\u1ED5i bay m\u1ED9t
      th\xE0nh ph\u1ED1."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802238
    m_Localized: "Zenith General: Th\u1EE9 b\u1ECDn ta t\xECm ki\u1EBFm,..... l\xE0
      s\u1EF1 \u0111i\xEAn cu\u1ED3ng, s\u1EF1 gi\u1EADn d\u1EEF,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802240
    m_Localized: "Zenith General: Tr\u1EDF th\xE0nh m\u1ED9t c\u1ED7 m\xE1y chi\u1EBFn
      \u0111\u1EA5u th\u1EF1c s\u1EF1 \u0111\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802287
    m_Localized: "Zenith General: hay l\xE0 m\u1ED9t con t\u1ED1t ngu ng\u1ED1c."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802285
    m_Localized: "Player: Nh\u1EADn ra \u0111i\u1EC1u g\xEC? \xFD ng\u01B0\u01A1i
      l\xE0 sao n\xF3i r\xF5 ra \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802220
    m_Localized: "Nh\u1EEFng c\u1ED7 m\xE1y c\u0169ng nh\u01B0 th\xED nghi\u1EC7m
      \u1EDF \u0111\xE2y l\xE0 sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802322
    m_Localized: "Player: H\u1EEB, xem nh\u01B0 ng\u01B0\u01A1i c\u0169ng kh\xE9o
      \u0103n n\xF3i,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802323
    m_Localized: "Player: nh\u01B0ng ng\u01B0\u01A1i kh\xF4ng s\u1EE3 ng\u01B0\u1EDDi
      c\u1EE7a ta \u0111ang nghe l\xE9n cu\u1ED9c tr\xF2 chuy\u1EC7n n\xE0y sao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802252
    m_Localized: "Zenith General: B\u1ECB san ph\u1EB3ng, c\u0169ng \u0111\u1ED3ng
      ngh\u0129a v\u1EDBi vi\u1EC7c,..."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802316
    m_Localized: "Zenith General: Kinh t\u1EDFm sao, \xFD ng\u01B0\u01A1i l\xE0 m\u1EA5y
      con robot sao,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802272
    m_Localized: "Zenith General: H\u1EE3p t\xE1c ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802227
    m_Localized: "Zenith General: hay l\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802337
    m_Localized: "Zenith General: Ch\xFAc may m\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802334
    m_Localized: "Zenith General: \u0110\u1EC3 ho\xE0n to\xE0n l\u1EEBa \u0111\u01B0\u1EE3c
      b\u1ECDn Apex,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802260
    m_Localized: "Zenith General: C\xE1i b\u1ED9 \u0111\xE0m tr\xEAn ng\u01B0\u1EDDi
      ng\u01B0\u01A1i l\xE0 t\u1EEB Apex \u0111\xFAng ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802321
    m_Localized: "Zenith General: n\xEAn ng\u01B0\u01A1i n\xEAn c\u1EA3m th\u1EA5y
      may m\u1EAFn \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802202
    m_Localized: "Zenith General: Hahaha, r\u1EDDi \u0111i sao,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802242
    m_Localized: "Zenith General: ng\u01B0\u01A1i ngh\u0129 \u0111i, d\xF9ng \u0111\u1ED3
      th\u1EADt kh\xF4ng ph\u1EA3i t\u1ED1t h\u01A1n sao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802264
    m_Localized: "Zenith General: b\u1ECDn ta s\u1EBD h\u1ED7 tr\u1EE3 ng\u01B0\u01A1i
      nh\u01B0ng sau \u0111\xF3.."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802215
    m_Localized: "Zenith General: ta ch\u1EC9 \u0111\u1EC1 ngh\u1ECB th\xF4i, ngh\u0129
      th\u1EED xem."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802273
    m_Localized: "Player: Ng\u01B0\u01A1i ngh\u0129 ta ngu ng\u1ED1c \u0111\u1EBFn
      m\u1EE9c \u0111i h\u1EE3p t\xE1c v\u1EDBi k\u1EBB th\xF9 \u0111\u1EC3 ph\u1EA3n
      l\u1EA1i \u0111\u1ED3ng minh sao"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802270
    m_Localized: "Zenith General: Hi\u1EC7n t\u1EA1i c\u1EA3 ta, hay ng\u01B0\u01A1i
      \u0111\u1EC1u \u0111ang ng\xE0n c\xE2n treo s\u1EE3i t\xF3c \u0111\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802294
    m_Localized: "Zenith General: N\xEAn d\xF9 ng\u01B0\u01A1i l\xE0m g\xEC \u0111i
      n\u1EEFa th\xEC ta, ng\u01B0\u01A1i v\xE0 c\u1EA3 h\xF2n \u0111\u1EA3o n\xE0y
      \u0111\u1EC1u s\u1EBD b\u1ECB ch\xFAng x\xF3a s\u1ED5."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802318
    m_Localized: "Zenith General: C\xF2n v\u1EC1 vi\u1EC7c t\u1EA1i sao ta l\u1EA1i
      m\u1EA5t c\xF4ng v\u1EADy sao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802331
    m_Localized: "Tao ch\u1EA5p nh\u1EADn l\u1EDDi \u0111\u1EC1 nghi, b\u1EAFt \u0111\u1EA7u
      th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802231
    m_Localized: "Player: \u0110\u1EEBng n\xF3i nh\u1EA3m n\u1EEFa, v\xE0o v\u1EA5n
      \u0111\u1EC1 ch\xEDnh \u0111i,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802254
    m_Localized: "Player: Nh\u01B0ng m\u1ED1i \u0111e d\u1ECDa n\xE0y,.. kh\xF4ng
      l\u1EBD \u0111\u1EBFn t\u1EEB..."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802236
    m_Localized: "Zenith General: \u0110\xF3 l\xE0,.... c\u1EA3m x\xFAc \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802234
    m_Localized: "Zenith General: c\u0169ng v\u1EABn thi\u1EBFu m\u1ED9t th\u1EE9
      m\xE0 kh\xF4ng m\u1ED9t thu\u1EADt to\xE1n n\xE0o c\xF3 th\u1EC3 thay th\u1EBF
      \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802230
    m_Localized: "Zenith General: Kh\xF4ng l\u1EBD ng\u01B0\u01A1i b\u1ECB d\u1ECDa
      s\u1EE3 \xE0.."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802297
    m_Localized: "Zenith General: V\u1EC1 c\u01A1 b\u1EA3n n\xF3 l\xE0 m\u1ED9t d\u1EA1ng
      thi\u1EBFt l\u1EADp v\u0169 kh\xED,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802250
    m_Localized: "Player: C\u1EA3nh b\xE1o c\u1EA5p \u0111\u1ECF?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802210
    m_Localized: "Zenith General: hay l\xE0...."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802271
    m_Localized: "Zenith General: N\xEAn l\xE0 thay v\xEC ti\u1EBFp t\u1EE5c c\u0103ng
      th\u1EB3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802336
    m_Localized: "Zenith General: Khi th\u1EDDi c\u01A1 \u0111\u1EBFn, th\xEC ng\u01B0\u01A1i
      s\u1EBD ch\xEDnh tay l\u1EADt v\xE1n c\u1EDD n\xE0y, hahaha"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802307
    m_Localized: "Zenith General: \u0110\u01A1n gi\u1EA3n l\xE0 v\u1EADy,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802188
    m_Localized: "Player: \u0110\xE2y...\u0111\xE2y l\xE0 g\xEC th\u1EBF n\xE0y..."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802284
    m_Localized: "Zenith General: T\u1EDBi hi\u1EC7n t\u1EA1i m\xE0 ng\u01B0\u01A1i
      v\u1EABn ch\u01B0a nh\u1EADn ra sao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802313
    m_Localized: "Player: Hi\u1EC7n \u0111\u1EA1i th\u1EBF c\u01A1 \xE0, th\u1EBF
      sao ng\u01B0\u01A1i kh\xF4ng t\u1EF1 x\u1EED l\xFD b\u1ECDn ta \u0111i"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802207
    m_Localized: "Zenith General: Ng\u01B0\u01A1i c\u0169ng \u0111\xE3 th\u1EA5y
      h\u1EBFt r\u1ED3i n\xEAn c\xF3 l\u1EBD ta kh\xF4ng th\u1EC3 bi\u1EC7n h\u1ED9
      \u0111\u01B0\u1EE3c n\u1EEFa nh\u1EC9,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802246
    m_Localized: "Zenith General: \u0110\xFAng l\xE0 ng\u01B0\u01A1i r\u1EA5t c\u1EA9n
      th\u1EADn nh\u01B0ng,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802213
    m_Localized: "Player: tao kh\xF4ng ngh\u0129 b\u1EA3n th\xE2n m\xECnh c\xF3 th\u1EC3
      ngu ng\u1ED1c \u0111\u1EBFn th\u1EBF."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802179
    m_Localized: "Player: C\xF2n \u0111\xF3 ch\u1EAFc l\xE0 Mech-721 sao"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802178
    m_Localized: "Player: \u0110\xE2y ch\u1EAFc l\xE0 ph\xF2ng gi\xE1m s\xE1t, c\xF3
      v\u1EBB kh\xE1 \xEDt l\xEDnh canh g\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802247
    m_Localized: "Zenith General: phe c\u1EE7a ng\u01B0\u01A1i th\xEC c\xF3 v\u1EBB
      kh\xF4ng mu\u1ED1n c\u1EA9n th\u1EADn nh\u01B0 th\u1EBF."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802249
    m_Localized: "Zenith General: c\xF3 v\u1EBB l\xE0 c\u1EA3nh b\xE1o c\u1EA5p \u0111\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802281
    m_Localized: "Sao ng\u01B0\u01A1i bi\u1EBFt \u0111\u01B0\u1EE3c ta \u1EDF \u0111\xE2y,
      v\xE0 t\u1EA1i sao l\u1EA1i \u0111\u1EC1 ngh\u1ECB h\u1EE3p t\xE1c?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802201
    m_Localized: "Stranger: N\xF3i chuy\u1EC7n ch\xFAt ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802225
    m_Localized: "Zenith General: c\xF2n b\u1ECDn ta th\xEC v\u0169 trang \u0111\u1EA7y
      \u0111\u1EE7..."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802310
    m_Localized: "Zenith General: Ai ch\xE0 kh\xF4ng ng\u1EDD ng\u01B0\u01A1i c\u0169ng
      c\xF3 th\u1EC3 h\u1ECFi c\xE2u n\xE0y \u0111\u1EA5y,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802237
    m_Localized: "Zenith General: Nh\u01B0ng \xFD ta kh\xF4ng ph\u1EA3i l\xE0 nh\u1EEFng
      th\u1EE9 c\u1EA3m x\xFAc \u0111\u1ED3ng c\u1EA3m hay s\u1EE3 h\xE3i v\xF4 v\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802298
    m_Localized: "Zenith General: \u0111\xE2y c\u0169ng l\xE0 th\xF4ng tin m\u1EADt
      m\xE0 b\u1ECDn ta \u0111\xE3 \u0111\xE1nh c\u1EAFp \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802293
    m_Localized: "Zenith General: V\xE0 n\xF3 hi\u1EC7n t\u1EA1i l\xE0 Buster Call."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802182
    m_Localized: "Player: \u0110\xE2y c\xF3 l\u1EBD l\xE0 th\xF4ng tin thi\u1EBFt
      k\u1EBF c\u1EE7a nh\u1EEFng c\u1ED5 m\xE1y kia"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802212
    m_Localized: "Player: H\u1EE3p t\xE1c v\u1EDBi nh\u1EEFng k\u1EBB nh\u01B0 ng\u01B0\u01A1i,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802205
    m_Localized: "Zenith General: N\xE0y n\xE0y b\xECnh t\u0129nh, ta kh\xF4ng c\xF3
      \xFD x\u1EA5u \u0111\xE2u,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802325
    m_Localized: "Zenith General: b\u1ED9 \u0111\xE0m tr\xEAn tai ng\u01B0\u01A1i
      ch\u1EE9 g\xEC, khi ng\u01B0\u01A1i b\u01B0\u1EDBc v\xE0o \u0111\xE2y th\xEC
      b\u1ECDn ta \u0111\xE3 c\u1EAFt s\xF3ng r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802308
    m_Localized: "Zenith General: sao hi\u1EC3u r\xF5 v\u1EC1 n\xF3 r\u1ED3i th\xEC
      ng\u01B0\u01A1i \u0111\xE3 suy ngh\u0129 xong ch\u01B0a."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802203
    m_Localized: "Zenith General: ng\u01B0\u01A1i n\xF3i nh\u01B0 th\u1EC3 mu\u1ED1n
      \u0111\u1EBFn l\xE0 \u0111\u1EBFn, \u0111i l\xE0 \u0111i nh\u1EC9"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802263
    m_Localized: "Zenith General: Gi\u1EDD ch\xFAng ta v\u1EABn ph\u1EA3i ti\u1EBFp
      t\u1EE5c v\u1EE1 k\u1ECBch n\xE0y n\xEAn ng\u01B0\u01A1i c\u1EE9 ti\u1EBFp
      t\u1EE5c nhi\u1EC7m v\u1EE5,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802276
    m_Localized: "Zenith General: V\xEC d\xF9 sao th\xEC k\u1EBFt c\u1EE5c c\u1EE7a
      ng\u01B0\u01A1i c\u0169ng ch\u1EC9 c\xF3 c\xE1i ch\u1EBFt,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802327
    m_Localized: "Zenith General: \u0111\xF3 l\xE0 l\xFD do t\u1EEB n\xE3y gi\u1EDD
      n\xF3 v\u1EABn im ru \u0111\u1EA5y th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802309
    m_Localized: "Player: C\u1EE9 t\u1EEB t\u1EEB \u0111i, ng\u01B0\u01A1i kh\xF4ng
      ph\u1EA3i g\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802267
    m_Localized: "Ng\u01B0\u01A1i n\u1EB1m m\u01A1 \u0111i th\xEC ta s\u1EBD \u0111i
      theo ng\u01B0\u01A1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802198
    m_Localized: "Player: V\xE0 n\u1EBFu h\xF2n \u0111\u1EA3o n\xE0y th\u1EF1c s\u1EF1
      b\u1ECB t\u1EA5n c\xF4ng m\xECnh c\u0169ng s\u1EBD g\u1EB7p nguy hi\u1EC3m,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802256
    m_Localized: "Zenith General: Haha, r\u1EA5t t\u1ED1t, ta mong ng\u01B0\u01A1i
      s\u1EBD \u0111\u01B0a ra l\u1EF1a ch\u1ECDn th\u1EADt s\xE1ng su\u1ED1t."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802224
    m_Localized: "Zenith General: Nh\xECn th\u1EED xem, ng\u01B0\u01A1i th\xEC 1
      th\xE2n 1 m\xECnh,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802338
    m_Localized: "N\u1EB1m m\u01A1 \u0111i, ta s\u1EBD kh\xF4ng bao gi\u1EDD theo
      c\xE1c ng\u01B0\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802228
    m_Localized: "Zenith General: \u0110i th\xED m\u1EA1ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802248
    m_Localized: "Zenith General: B\u1ECDn ta \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c
      th\xF4ng tin t\u1EEB Khu gi\xE1m s\xE1t,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802185
    m_Localized: "Player: C\xF3 l\u1EBD \u0111\xE2y l\xE0 b\u1EA3ng \u0111i\u1EC1u
      khi\u1EC3n trung t\xE2m,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802233
    m_Localized: "Zenith General: Ng\u01B0\u01A1i c\u0169ng bi\u1EBFt r\xF5 l\xE0
      m\u1ED9t c\u1ED7 m\xE1y d\xF9 th\xF4ng minh \u0111\u1EBFn m\u1EA5y,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802232
    m_Localized: "Player: nh\u1EEFng c\u1ED7 m\xE1y n\xE0y l\xE0 sao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802292
    m_Localized: "Zenith General: m\u1EE9c \u0111\u1ECF l\xE0 m\u1EE9c cao nh\u1EA5t
      cho 1 m\u1ED1i nguy h\u1EA1i c\xF3 th\u1EC3 x\xF3a s\u1ED5 c\u1EA3 h\xF2n \u0111\u1EA3o
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802288
    m_Localized: "Zenith General: Ngh\u0129 \u0111i, m\u1ED9t m\xECnh ng\u01B0\u01A1i,
      tay kh\xF4ng t\u1EA5t s\u1EAFt x\xF4ng v\xE0o \u0111\u1ECBa b\xE0n c\u1EE7a
      k\u1EBB th\xF9 v\u0169 trang \u0111\u1EA7y \u0111\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802199
    m_Localized: "Player: V\u1EABn n\xEAn nhanh ch\xF3ng ho\xE0n th\xE0nh nhi\u1EC7m
      v\u1EE5 r\u1ED3i r\xFAt lui th\xEC h\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802265
    m_Localized: "Zenith General: Ch\xEDnh ng\u01B0\u01A1i s\u1EBD c\u1EA7n quay
      l\u1EA1i \u0111\u1EC3 ti\xEAu di\u1EC7t to\xE0n b\u1ED9 b\u1ECDn ch\xFAng,
      hahahaha."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802181
    m_Localized: "Player: C\xF3 v\u1EBB \u1EDF \u0111\xE2y xong r\u1ED3i, ti\u1EBFn
      v\xE0o trong th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802258
    m_Localized: "Zenith General: Haha, ng\u01B0\u01A1i th\xF4ng minh h\u01A1n ta
      ngh\u0129,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802289
    m_Localized: "Zenith General: N\xF3 \u0111\xE3 c\u01A1 b\u1EA3n l\xE0 m\u1ED9t
      chuy\u1EBFn \u0111i n\u1ED9p m\u1EA1ng r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802243
    m_Localized: "Player: Th\u1EADt \u0111\xFAng l\xE0 l\u0169 man r\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802218
    m_Localized: "Zenith General: N\xEAn l\xE0,..... c\u1EE9 suy ngh\u0129 cho k\u1EF9."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802274
    m_Localized: "Zenith General: Haizzz, ngu ng\u1ED1c hay kh\xF4ng l\xE0 vi\u1EC7c
      c\u1EE7a ng\u01B0\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802311
    m_Localized: "Zenith General: C\u1EA3 h\xF2n \u0111\u1EA3o n\xE0y d\xF9 l\xE0
      n\u01A1i th\xED nghi\u1EC7m nh\u01B0ng t\u1EEBng con ru\u1ED3i con m\u0169i
      ta c\xF2n n\u1EAFm r\xF5 trong l\xF2ng b\xE0n tay"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802328
    m_Localized: "Zenith General: Sao, gi\u1EDD quy\u1EBFt \u0111\u1ECBnh \u0111\u01B0\u1EE3c
      r\u1ED3i ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802282
    m_Localized: "\u0110\u1EE7 r\u1ED3i. Tao \u0111\xE3 quy\u1EBFt \u0111\u1ECBnh
      xong b\u01B0\u1EDBc \u0111i ti\u1EBFp theo c\u1EE7a m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802302
    m_Localized: "Zenith General: N\xF3 s\u1EED d\u1EE5ng ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng
      h\u1EA1t nh\xE2n \u0111\u1EC3 l\xE0m ng\xF2i n\u1ED5,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802280
    m_Localized: "Nh\u01B0ng c\xE1i th\xF4ng b\xE1o v\u1EC1 m\u1ED1i \u0111e d\u1ECDa
      \u0111\xF3 Buster Call l\xE0 g\xEC?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802320
    m_Localized: "Zenith General: T\u1EF1 tay h\u1EE7y \u0111i m\u1ED9t c\u1ED5 m\xE1y
      chi\u1EBFn \u0111\u1EA5u s\u1ED1ng nh\u01B0 th\u1EBF n\xE0y xem nh\u01B0 c\xF3
      ch\xFAt ti\u1EBFc nu\u1ED1i,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802239
    m_Localized: "Zenith General: \u0111\xF3 l\xE0 nh\u1EEFng th\u1EE9 c\xF3 th\u1EC3
      gi\xFAp m\u1ED9t c\u1ED7 m\xE1y v\xF4 tri v\xF4 gi\xE1c,.."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802211
    m_Localized: "Zenith General: H\u1EE3p t\xE1c ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802333
    m_Localized: "Zenith General: Ng\u01B0\u01A1i kh\xF4ng m\xF9 qu\xE1ng v\xE0 trung
      th\xE0nh ngu ng\u1ED1c nh\u01B0 ta t\u01B0\u1EDFng."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802266
    m_Localized: "Zenith General: Ch\xFAc may m\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802209
    m_Localized: "Zenith General: Thay v\xEC gi\u1EDD gi\u1EBFt ng\u01B0\u01A1i \u1EDF
      \u0111\xE2y th\xEC c\u0169ng th\u1EADt ph\xED ph\u1EA1m m\u1ED9t nh\xE2n t\xE0i,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802257
    m_Localized: "Ta ch\u1EA5p nh\u1EADn l\u1EDDi \u0111\u1EC1 ngh\u1ECB. B\u1EAFt
      \u0111\u1EA7u th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802244
    m_Localized: "Zenith General: Hahaha, c\u1EA3m \u01A1n v\xEC l\u1EDDi khen."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802229
    m_Localized: "Zenith General: Hahaa, nh\u1EEFng th\xED nghi\u1EC7m \u1EDF \u0111\xE2y
      sao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802324
    m_Localized: "Zenith General: \xC0 chuy\u1EC7n \u0111\xF3 ng\u01B0\u01A1i kh\xF4ng
      c\u1EA7n lo,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802268
    m_Localized: "Zenith General: L\xE0 do m\xE0y ch\u1ECDn th\xF4i, ch\xFAc may
      m\u1EAFn."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802317
    m_Localized: "Zenith General: \u1ED3 c\u0169ng b\xECnh th\u01B0\u1EDDng th\xF4i,
      \u0111\xF3 l\xE0 hy sinh v\xEC khoa h\u1ECDc th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802295
    m_Localized: "Zenith General: H\u1EEDm..., ng\u01B0\u01A1i th\u1EADt s\u1EF1
      kh\xF4ng bi\u1EBFt v\u1EC1 n\xF3 sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802192
    m_Localized: "Player: Ra v\u1EADy \u0111\xF3 l\xE0 l\xFD do v\xEC sao nh\u1EEFng
      c\u1ED5 m\xE1y n\xE0y l\u1EA1i th\xF4ng minh \u0111\u1EBFn v\u1EADy,"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802262
    m_Localized: "Zenith General: n\xEAn cu\u1ED9c tr\xF2 chuy\u1EC7n c\u1EE7a ch\xFAng
      ta, ch\xFAng kh\xF4ng bi\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802306
    m_Localized: "Zenith General: b\u1EDFi v\xEC n\u1ED3ng \u0111\u1ED9 ph\xF3ng
      x\u1EA1 r\u1EA5t cao."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802183
    m_Localized: "Player: Nh\u01B0ng sao...., tr\xF4ng n\xF3 l\u1EA1i k\u1EF3 l\u1EA1
      th\u1EBF n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802315
    m_Localized: "Player: Ta kh\xF4ng ngh\u0129 c\xE1c ng\u01B0\u01A1i t\u1ED1t \u0111\u1EBFn
      th\u1EBF v\u1EDBi nh\u1EEFng vi\u1EC7c kinh t\u1EDFm m\xECnh \u0111\xE3 l\xE0m."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802195
    m_Localized: "Player: H\xF2n \u0111\u1EA3o n\xE0y \u0111ang b\u1ECB \u0111e d\u1ECDa
      sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802180
    m_Localized: "Player: C\xF3 v\u1EBB \u1EDF \u0111\xE2y xong r\u1ED3i, ti\u1EBFn
      v\xE0o trong th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802312
    m_Localized: "Zenith General: H\u1EC7 th\u1ED1ng radar tr\xEAn \u0111\u1EA3o
      l\xE0 lo\u1EA1i t\u1ED1i t\xE2n nh\u1EA5t n\xEAn t\u1EEB khi ng\u01B0\u01A1i
      \u0111i v\xE0o l\xE0 b\u1ECDn ta \u0111\xE3 bi\u1EBFt r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802219
    m_Localized: "\xDD ng\u01B0\u01A1i mu\u1ED1n n\xF3i l\xE0 g\xEC, Apex th\xEC
      sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802251
    m_Localized: "Zenith General: D\u1EC5 hi\u1EC3u th\xEC \u1EDF c\u1EA5p c\u1EA3nh
      b\xE1o n\xE0y h\xF2n \u0111\u1EA3o n\xE0y s\u1EBD c\xF3 nguy c\u01A1,..."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802204
    m_Localized: "Player: Ng\u01B0\u01A1i l\xE0 ai..."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802200
    m_Localized: "Stranger: Kh\xE1 khen cho ng\u01B0\u01A1i khi c\xF3 th\u1EC3 \u0111\u1EBFn
      t\u1EADn \u0111\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802255
    m_Localized: "Zenith General: C\xF2n ai v\xE0o \u0111\xE2y, l\xE0 t\u1EADp \u0111o\xE0n
      Apex."
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802177
    m_Localized: "Player: C\xF2n \u0111\xF3 ch\u1EAFc l\xE0 Mech-721 sao"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802279
    m_Localized: "Ng\u01B0\u01A1i c\xF3 \xFD g\xEC..Apex li\xEAn quan g\xEC \u1EDF
      \u0111\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802341
    m_Localized: "Zenith General: Ng\u01B0\u01A1i \u0111\u01B0\u1EE3c l\u1EAFm, nh\u01B0ng
      d\xF9 th\u1EBF n\xE0o \u0111i n\u1EEFa k\u1EBFt c\u1EE5c c\u1EE7a ng\u01B0\u01A1i
      c\u0169ng ch\u1EC9 c\xF3 1 m\xE0 th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 509934394802269
    m_Localized: "Zenith General: Nh\u01B0 nh\u1EEFng g\xEC ng\u01B0\u01A1i \u0111\xE3
