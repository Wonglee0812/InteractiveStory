  m_Script: {fileID: 11500000, guid: d60acb52818515a4dabee2db66071acd, type: 3}
  m_Name: Node_03_Start
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData3D
  lines:
  - ' Halt. Sentinels ahead. Hide in the tall grass, it can help you hide before
    them. '
  - Scavenge the supply crates for ammo and meds. Survive long enough to finish the
    job
  - Raptorechs before. Thick armor. Shoot the glowing Core on their bodies. One piercing
    shot is enough
  - One piercing shot is enough
  - 'Use [Tab] to switch arrows: Explosive for armor, Smoke for evasion, Warhead
    for groups. Execute them efficiently.'
  typingSpeed: 0.01
  delayBetweenLines: 1
  isLock: 0
